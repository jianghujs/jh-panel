          "code": "echo standby > /www/server/ha_manager_local/role",
          "group": "标记为备机"
        },
        {
          "key": "standby_check",
          "title": "执行备机自检",
          "desc": "确认 OpenResty、rsync 和任务状态符合备机预期。",
          "stage": "状态确认",
          "phase": "standby_offline",
          "guide_ref": "health_check",
          "check_health": true,
          "code": "btpython /www/server/jh-panel/plugins/ha_manager_local/index.py health_check \"{}\"",
          "group": "备机自检"
        }
      ]
    }
  },
  "guides": {
    "default": {
      "text": "当前步骤执行失败，请先查看日志输出，再按提示处理后重新进入该步骤。",
      "commands": [
        {
          "desc": "查看 MySQL 服务状态",
          "cmd": "systemctl status mysqld --no-pager"
        },
        {
          "desc": "查看面板最近错误日志",
          "cmd": "tail -n 100 /www/server/jh-panel/logs/error.log"
        }
      ]
    },
    "promote_mysql": {
      "text": "MySQL 提升为主失败时，优先在备用机使用 jh 22 脚本库里的“修复MySQL从库：从xtrabackup备份中恢复从库和GTID事务”脚本。\n先用最近的 xtrabackup 备份把备用机恢复到可接入状态；必要时在主机重新做一次 xtrabackup 备份，保证 GTID 一致，再重新建立主从同步。\n如果恢复后仍失败，先确认两边 MySQL 状态、备份文件和 GTID 信息是否一致。",
      "commands": [
        {
          "desc": "查看 MySQL 服务是否正常运行",
          "cmd": "systemctl status mysqld --no-pager"
        },
        {
          "desc": "打开 jh 22 脚本库中的修复入口",
          "cmd": "bash /www/server/os_tool/vm/default/index__repair.sh"
        },
        {
          "desc": "直接执行从 xtrabackup 恢复从库和 GTID 的脚本",
          "cmd": "bash /www/server/os_tool/vm/default/repair__restore_mysql_slave_from_xtrabackup.sh"
        }
      ]
    },
    "mysql": {
      "text": "MySQL 状态异常时，先确认 mysqld 服务是否正常启动，再检查端口和错误日志。\n如果数据库插件显示异常，先处理数据库服务后再继续。",
      "commands": [
        {
          "desc": "查看 MySQL 服务状态",
          "cmd": "systemctl status mysqld --no-pager"
        },
        {
          "desc": "重启 MySQL 服务",
          "cmd": "systemctl restart mysqld"
        },
        {
          "desc": "确认 3306 端口是否监听",
          "cmd": "ss -lntp | grep 3306"
        }
      ]
    },
    "openresty": {
      "text": "OpenResty 相关步骤失败时，先确认进程是否残留，再检查 systemctl 状态和端口占用。\n如果被其他 nginx 或进程占用，先停止冲突服务再重试。",
      "commands": [
        {
          "desc": "查看 OpenResty 服务状态",
          "cmd": "systemctl status openresty --no-pager"
        },
        {
          "desc": "检查 80/443 端口占用",
          "cmd": "ss -lntp | grep -E \":80|:443\""
        },
        {
          "desc": "停止可能冲突的系统 nginx",
          "cmd": "systemctl stop nginx || true"
        }
      ]
    },
    "wwwstorage_dryrun": {
      "text": "预检查失败时，先确认 /www/wwwstorage 目录是否可访问，再确认对端 IP、SSH 登录和目录权限。\n如果 dry-run 输出存在差异，先确认两边是否仍有写入，再决定是否同步。",
      "commands": [
        {
          "desc": "统计本机 /www/wwwstorage 文件数量",
          "cmd": "find /www/wwwstorage -type f | wc -l"
        },
        {
          "desc": "查看本机 /www/wwwstorage 目录大小",
          "cmd": "du -sh /www/wwwstorage"
        },
        {
          "desc": "dry-run 对比两边 /www/wwwstorage 差异",
          "cmd": "rsync -avzn --delete /www/wwwstorage/ root@对端IP:/www/wwwstorage/"
        }
      ]
    },
    "checksum": {
      "text": "checksum 检查发现异常时，先确认两边文件是否仍在变动，再决定是否继续。\n如果文件还在变化，先暂停相关写入后重新检查。",
      "commands": [
        {
          "desc": "生成本机文件列表校验值",
          "cmd": "find /www/wwwstorage -type f -printf \"%P\\n\" | sort | md5sum"
        },
        {
          "desc": "生成本机文件内容校验值",
          "cmd": "find /www/wwwstorage -type f -exec md5sum {} \\; | sort | md5sum"
        }
      ]
    },
    "xtrabackup_restore": {
      "text": "xtrabackup 增量恢复失败时，先确认备份文件是否存在、备份链是否完整、磁盘空间是否足够。\n如果恢复脚本报错，先查看 xtrabackup 日志，再决定是否改用最近一次完整备份。",
      "commands": [
        {
          "desc": "查看 xtrabackup-inc 服务目录",
          "cmd": "ls -lah /www/server/xtrabackup-inc"
        },
        {
          "desc": "查看最近的 xtrabackup-inc 日志",
          "cmd": "ls -t /www/server/xtrabackup-inc/logs/* 2>/dev/null | head"
        },
        {
          "desc": "查看备份目录空间占用",
          "cmd": "df -h /www/backup"
        }
      ]
    },
    "setting_restore": {
      "text": "配置恢复失败时，先确认备份文件存在并且可以解压，再检查目标目录权限。\n如果导入脚本报错，先确认备份文件版本和当前面板版本是否兼容。",
      "commands": [
        {
          "desc": "查看网站配置备份文件",
          "cmd": "ls -t /www/backup/site_setting/*.zip 2>/dev/null | head"
        },
        {
          "desc": "查看插件配置备份文件",
          "cmd": "ls -t /www/backup/plugin_setting/*.zip 2>/dev/null | head"
        },
        {
          "desc": "确认备份文件能正常解压",
          "cmd": "unzip -t 备份文件.zip"
        }
      ]
    },
    "ssh_key": {
      "text": "同步公钥授权失败时，先检查 /root/.ssh 目录权限和 authorized_keys 文件内容。\n如果 key 不存在，先重新生成或同步公钥后再执行。",
      "commands": [
        {
          "desc": "查看 SSH 授权文件权限",
          "cmd": "ls -ld /root/.ssh && ls -l /root/.ssh/authorized_keys"
        },
        {
          "desc": "检查同步公钥是否已经授权",
          "cmd": "grep -n \"standby_sync\" /root/.ssh/authorized_keys"
        },
        {
          "desc": "修正 SSH 授权目录权限",
          "cmd": "chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys"
        }
      ]
    },
    "cron": {
      "text": "计划任务调整失败时，先确认对应计划任务是否存在，再检查任务名称是否和面板中一致。\n如果任务不存在，先到对应插件重新保存任务配置，再回到这里执行。",
      "commands": [
        {
          "desc": "查看计划任务列表中是否存在对应任务",
          "cmd": "sqlite3 /www/server/panel/data/default.db \"select id,name,status from crontab where name like '%备份%' or name like '%恢复%' or name like '%xtrabackup%';\""
        },
        {
          "desc": "查看面板计划任务日志目录",
          "cmd": "ls -lah /www/server/cron"
        },
        {
          "desc": "查看面板最近错误日志",
          "cmd": "tail -n 100 /www/server/jh-panel/logs/error.log"
        }
      ]
    },
    "notify": {
      "text": "通知配置调整失败时，先确认通知插件或面板通知配置是否正常，再查看脚本输出。\n如果通知项不存在，先到对应通知配置页面保存一次配置。",
      "commands": [
        {
          "desc": "查看面板通知相关配置",
          "cmd": "ls -lah /www/server/panel/data | grep -i notify"
        },
        {
          "desc": "查看面板最近错误日志",
          "cmd": "tail -n 100 /www/server/jh-panel/logs/error.log"
        },
        {
          "desc": "查看当前步骤脚本是否存在",
          "cmd": "ls -lah /www/server/jh-panel/plugins/ha_manager_local/scripts"
        }
      ]
    },
    "rsyncd_tasks": {
      "text": "rsyncd 任务状态调整失败时，先确认 rsyncd 插件是否已安装，以及 /www/server/rsyncd/config.json 是否存在。\n如果任务列表为空，先到 rsyncd 插件确认同步任务配置。",
      "commands": [
        {
          "desc": "确认 rsyncd 配置文件存在",
          "cmd": "ls -l /www/server/rsyncd/config.json"
        },
        {
          "desc": "查看 rsyncd 同步任务名称",
          "cmd": "python3 - <<'PY'\nimport json\nprint('\\n'.join([x.get('name', '') for x in json.load(open('/www/server/rsyncd/config.json')).get('send', {}).get('list', [])]))\nPY"
        },
        {
          "desc": "查看 rsyncd 插件入口",
          "cmd": "ls -lah /www/server/jh-panel/plugins/rsyncd"
        }
      ]
    },
    "lsyncd": {
      "text": "同步服务调整失败时，先查看 lsyncd 服务状态和残留 rsync 进程。\n如果服务文件不存在，先到 rsyncd 插件重建配置或重新安装服务。",
      "commands": [
        {
          "desc": "查看 lsyncd 服务状态",
          "cmd": "systemctl status lsyncd --no-pager"
        },
        {
          "desc": "查看残留 rsync 进程",
          "cmd": "ps aux | grep '/bin/[r]sync'"
        },
        {
          "desc": "查看 lsyncd 最近日志",
          "cmd": "tail -n 100 /www/server/rsyncd/logs/lsyncd.log"
        }
      ]
    },
    "role": {
      "text": "角色标记失败时，先确认本机状态是否已经切到目标角色对应的服务状态，再重新执行角色写入。\n如果前置步骤未完成，先补齐前置步骤后再继续。",
      "commands": [
        {
          "desc": "查看本机角色标记文件",
          "cmd": "cat /www/server/ha_manager_local/role"
        },
        {
          "desc": "确认角色目录存在",
          "cmd": "mkdir -p /www/server/ha_manager_local && ls -ld /www/server/ha_manager_local"
        },
        {
          "desc": "查看当前 OpenResty 服务状态",
          "cmd": "systemctl status openresty --no-pager"
        }
      ]
    },
    "health_check": {
      "text": "自检失败时，先打开自检结果，逐项处理异常项，再重新执行自检。\n如果是服务状态不一致，先修正服务状态后再复查。",
      "commands": [
        {
          "desc": "重新执行本插件自检",
          "cmd": "btpython /www/server/jh-panel/plugins/ha_manager_local/index.py health_check \"{}\""
        },
        {
          "desc": "查看 OpenResty 服务状态",
          "cmd": "systemctl status openresty --no-pager"
        },
        {
          "desc": "查看 lsyncd 服务状态",
          "cmd": "systemctl status lsyncd --no-pager"
        }
      ]
    }
  }
}
